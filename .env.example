# Copy this file to `.env` and customize the values for your environment.
# Do not commit `.env` because it may contain secrets.

# Web scraping settings
UFSG_SCRAPER_SOURCE_URL=https://sg.ufl.edu/branches/legislative/senate-resources/
UFSG_DOWNLOAD_DIR=bills
UFSG_PDF_URLS_PATH=pdf_urls.txt

# PDF conversion and extraction
UFSG_CONVERSION_INPUT_DIR=bills
UFSG_CONVERSION_OUTPUT_DIR=bills-converted
UFSG_EXTRACTION_INPUT_DIR=test
UFSG_BILL_RESULTS_PATH=bill_results.json

# Data export/import
UFSG_LEGISLATION_DATA_PATH=legislation_data.json

# Credentials (provide either a path to the JSON file or the JSON string itself)
FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/firebase-admin.json
OPENAI_API_KEY=sk-your-openai-key
